# ──────────────────────────────────────────────────────────────────────────────
# CuraBot+ Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  copy .env.example .env   (Windows)
# 2. Edit .env with your real values.
# 3. NEVER commit .env to Git — it may contain credentials.
# ──────────────────────────────────────────────────────────────────────────────

# The base URL of the ESP32 HTTP server.
# Find the IP by opening Serial Monitor after uploading the sketch.
# The ESP32 will print:  "ESP32 IP Address: 192.168.x.x"
ESP32_URL=http://192.168.29.162

# How long (milliseconds) to wait for the ESP32 before declaring it offline.
ESP32_TIMEOUT_MS=5000

# The port the Node.js backend listens on.
PORT=3000
